{
  "base_model": "Qwen/Qwen3-8B",
  "precision": "fp16",
  "device": "cuda",
  "env": "ac2",
  "problem_idx": "improvement",
  "budget_s": 1000,
  "group_size": 8,
  "groups_per_batch": 8,
  "learning_rate": 4e-05,
  "num_epochs": 10,
  "max_tokens": 260000,
  "temperature": 1.0,
  "adv_estimator": "entropic_adaptive_beta",
  "adv_estimator_beta": 2.0,
  "loss_fn": "importance_sampling",
  "ppo_clip": 0.2,
  "num_substeps": 1,
  "remove_constant_reward_groups": true,
  "kl_penalty_coef": 0.01,
  "kl_discount_factor": 0.0,
  "compute_post_kl": false,
  "dynamic_max_tokens": true,
  "two_phase_sampling": true,
  "phase1_max_tokens": 26000,
  "context_window": 32768,
  "context_buffer": 50,
  "eval_timeout": 1100,
  "dataset_timeout": 1200,
  "num_cpus_per_task": 2,
  "gpu_mode_score_scale": 3000.0,
  "num_ensemble_members": 5,
  "lora_rank": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "target_modules": {
    "q_proj": true,
    "k_proj": true,
    "v_proj": true,
    "o_proj": true
  },
  "rmi_coef": 0.1,
  "uncertainty_metric": "true_mi",
  "gamma_max_ratio": 10.0,
  "nnm_coef": 0.075,
  "nnm_use_fro_norm": false,
  "streaming_mi_enabled": false,
  "streaming_mi_window_size": 4096,
  "streaming_mi_check_interval": 2048,
  "streaming_mi_min_gen": 4096,
  "streaming_mi_warmup_epochs": 3,
  "streaming_mi_wrap_budget": 6000,
  "streaming_mi_threshold_percentile": 25.0,
  "kv_quantize": false,
  "sampler_type": "puct_backprop",
  "initial_exp_type": "random_no_code",
  "log_path": "./logs/ac2_rmi_nnm_streaming",
  "wandb_project": "ttt-discover-uncertainty",
  "wandb_name": "ac2-streaming-truemi-r16-nnm",
  "eval_every": 3,
  "save_every": 3,
  "dataset_builder": null
}